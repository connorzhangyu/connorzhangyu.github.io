&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="kd"&gt;contract&lt;/span&gt; &lt;span class="nc"&gt;helloworld&lt;/span&gt;&lt;span class="p"&gt;{&lt;/span&gt;
