&lt;tbody>
&lt;tr>
&lt;td>插入模式（前 / 后）&lt;/td>
&lt;td>&lt;code>i&lt;/code> / &lt;code>a&lt;/code>&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>新行（下 / 上）&lt;/td>
&lt;td>&lt;code>o&lt;/code> / &lt;code>O&lt;/code>&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>删除当前行&lt;/td>
&lt;td>&lt;code>dd&lt;/code>&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>复制当前行&lt;/td>
&lt;td>&lt;code>yy&lt;/code>&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>粘贴到光标后&lt;/td>
&lt;td>&lt;code>p&lt;/code>&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>撤销&lt;/td>
&lt;td>&lt;code>u&lt;/code>&lt;/td>
&lt;/tr>
&lt;/tbody>
&lt;/table>
&lt;hr>
&lt;h3 id="3-查找2-个">3. 查找（2 个）&lt;/h3>
&lt;table>
