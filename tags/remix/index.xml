<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Remix on Hello World!</title><link>https://tosa.team/tags/remix/</link><description>Recent content in Remix on Hello World!</description><generator>Hugo</generator><language>zh</language><lastBuildDate>Mon, 04 Aug 2025 01:38:57 +0700</lastBuildDate><atom:link href="https://tosa.team/tags/remix/index.xml" rel="self" type="application/rss+xml"/><item><title>Dapp</title><link>https://tosa.team/posts/dapp/</link><pubDate>Thu, 29 May 2025 10:23:17 +0000</pubDate><guid>https://tosa.team/posts/dapp/</guid><description>&lt;h1 id="helloworld合约">HelloWorld合约&lt;/h1>
