&lt;table>
 &lt;thead>
 &lt;tr>
 &lt;th>阶段&lt;/th>
 &lt;th>时间范围&lt;/th>
 &lt;th>目标&lt;/th>
 &lt;/tr>
 &lt;/thead>
 &lt;tbody>
 &lt;tr>
 &lt;td>基础语法期&lt;/td>
 &lt;td>Day 1 ～ Day 4&lt;/td>
 &lt;td>掌握语法、指针、结构体、接口等基础能力&lt;/td>
 &lt;/tr>
 &lt;tr>
 &lt;td>并发理解期&lt;/td>
 &lt;td>Day 5 ～ Day 6&lt;/td>
 &lt;td>熟练使用 goroutine、channel、锁等并发机制&lt;/td>
 &lt;/tr>
 &lt;tr>
 &lt;td>框架实战期&lt;/td>
 &lt;td>Day 7 ～ Day 10&lt;/td>
 &lt;td>掌握 Gin、GORM、JWT、Redis、配置管理等项目能力&lt;/td>
 &lt;/tr>
 &lt;tr>
 &lt;td>项目构建期&lt;/td>
 &lt;td>Day 11 ～ Day 12&lt;/td>
 &lt;td>完整开发项目并调试测试，准备部署&lt;/td>
 &lt;/tr>
 &lt;tr>
 &lt;td>面试冲刺期&lt;/td>
 &lt;td>Day 13 ～ Day 14&lt;/td>
 &lt;td>刷题 + 模拟面试 + 简历完善 + 项目讲解&lt;/td>
 &lt;/tr>
 &lt;/tbody>
&lt;/table>
